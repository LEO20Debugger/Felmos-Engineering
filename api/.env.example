# Copy to .env for local development. On Railway these are service variables.
# Never commit the filled-in version — .gitignore covers .env* but whitelists
# this template.

# ── database ──────────────────────────────────────────────────────────────
# Railway: use the MySQL service's PRIVATE url (mysql.railway.internal). The
# public one routes through the internet and is billed as egress.
# Locally: any MySQL 8 instance. MySQL 8 is required, not 5.7 — the schema uses
# STORED generated columns to make uniqueness work under soft delete.
DATABASE_URL=mysql://root:password@localhost:3306/felmos

# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Where uploaded images live. On Railway this MUST equal the volume's mount
# path exactly — if it doesn't, the app writes to ordinary container disk and
# every upload is lost on the next deploy. The boot check in
# src/common/media-root.ts warns when the directory is unexpectedly empty.
MEDIA_ROOT=./.data

# ── secrets ───────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Salt for hashing IP addresses and building daily analytics session hashes.
# Rotating it is a privacy feature: it permanently breaks the ability to
# correlate old sessions with new ones.
APP_SALT=

# Shared with the public site, so its server-side fetchers can read published
# content and file leads. Resolved to a company via the api_keys table.
INTERNAL_API_KEY=

# ── mail ──────────────────────────────────────────────────────────────────
# Inspection notifications go out through Resend over HTTPS. A server cannot
# hand mail straight to a mailbox provider — cloud hosts block the outbound
# SMTP port, and mail from an unrecognised IP is treated as spam — so this uses
# an API instead, with the sending domain authenticated by SPF/DKIM records
# rather than by signing in to somebody's mailbox.
#
# MAIL_FROM must be on a domain verified in Resend (Domains → Add → add the
# DNS records it gives you). An address on an unverified domain is rejected at
# send time, not at startup.
#
# Both must be set. With either missing the app records enquiries and leaves
# them 'pending' rather than failing them, and sends everything outstanding on
# the first cron run after the credentials appear.
RESEND_API_KEY=
MAIL_FROM="Felmos Engineering <bookings@felmosengineering.com>"

# ── origins ───────────────────────────────────────────────────────────────
# Comma-separated. CORS_ORIGINS is the admin dashboard; ANALYTICS_ORIGINS is
# the public site, which posts beacons directly from the browser.
CORS_ORIGINS=http://localhost:3001
ANALYTICS_ORIGINS=http://localhost:3000

# Where to send cache-revalidation webhooks when content changes. Per-company
# values live in the companies table; this is only the fallback for local dev.
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=
