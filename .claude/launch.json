{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "felmos-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "comment": "Same app on a spare port, skipping predev — which frees 3000 by killing whatever holds it, including another session's server.",
      "name": "felmos-web-alt",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd web && npx next dev --turbopack -p 3100"],
      "port": 3100
    },
    {
      "name": "felmos-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "felmos-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "api", "run", "start:dev"],
      "port": 4000,
      "autoPort": true
    }
  ]
}
