{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "felmos-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "felmos-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "felmos-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "api", "run", "start:dev"],
      "port": 4000,
      "autoPort": true
    }
  ]
}
